{
  "mcpServers": {
    "cotlet": {
      "url": "https://cotlet.dev/mcp/v1",
      "headers": {
        "Authorization": "Bearer ${COTLET_API_KEY}"
      }
    },
    "taxdome": {
      "command": "uvx",
      "args": ["--from", "git+https://github.com/cotlet-connect/taxdome-mcp", "taxdome-mcp"],
      "env": {
        "COTLET_API_KEY": "${COTLET_API_KEY}"
      }
    }
  }
}
